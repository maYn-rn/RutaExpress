# Copiar a .env en la EC2 y completar. .env NO se sube a GitHub.

# Amazon RDS (MySQL): endpoint que aparece en la consola de RDS -> Connectivity
RDS_HOST=rutaexpress-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=3306
RDS_USER=admin
RDS_PASSWORD=cambiar
# Una base de datos por microservicio (se crean solas al primer arranque)
CATALOG_DB_NAME=catalog_db
SHIPMENTS_DB_NAME=shipments_db

# Azure AD (App Registration)
AZURE_TENANT_ID=73167dfd-6b0e-45bd-8f35-cfbfa398d638
AZURE_CLIENT_ID=a6f94bc4-ccff-4caa-bd7e-af0abf92e36b

# Origen(es) del frontend, separados por coma
FRONTEND_ORIGIN=http://localhost:3000
